[Unit]
Description=LogWarden partition and retention maintenance
After=postgresql.service

[Service]
Type=oneshot
User=logwarden
Group=logwarden
WorkingDirectory=/opt/logwarden
ExecStart=/usr/bin/php /opt/logwarden/bin/logwarden-maintenance
EnvironmentFile=-/etc/logwarden/env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/logwarden/var
