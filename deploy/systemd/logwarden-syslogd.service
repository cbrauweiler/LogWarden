[Unit]
Description=LogWarden syslog ingestion daemon
Documentation=file:/opt/logwarden/docs
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=logwarden
Group=logwarden
WorkingDirectory=/opt/logwarden
ExecStart=/usr/bin/php /opt/logwarden/bin/logwarden-syslogd
Restart=always
RestartSec=5

# Keep the database password out of config.php; see Config's LW_ env override.
EnvironmentFile=-/etc/logwarden/env

# Binding 514 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
ReadWritePaths=/opt/logwarden/var

# UDP bursts from several FortiGates can overrun the default receive buffer.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
