<?php
/**
 * LogWarden configuration.
 *
 * Copy to config/config.php and adjust. config/config.php is gitignored.
 * Every value can be overridden by an environment variable of the same name
 * in SCREAMING_SNAKE_CASE with an LW_ prefix, e.g. LW_DB_PASSWORD.
 */

declare(strict_types=1);

return [
    'db' => [
        'host'     => '127.0.0.1',
        'port'     => 5432,
        'name'     => 'logwarden',
        'user'     => 'logwarden',
        'password' => 'change-me',
        // Statement timeout for web queries (ms). Keeps a runaway search from
        // pinning a core; the CLI workers override this with their own value.
        'statement_timeout_ms' => 30000,
    ],

    // Path to the 32-byte libsodium master key used to encrypt the `secrets`
    // table. Generate with: bin/logwarden-keygen
    'secret_key_file' => LW_ROOT . '/config/secret.key',

    'syslog' => [
        // Fortinet sends to these. Ports below 1024 need CAP_NET_BIND_SERVICE
        // (see deploy/systemd/logwarden-syslogd.service).
        'udp'  => ['enabled' => true,  'bind' => '0.0.0.0', 'port' => 514],
        'tcp'  => ['enabled' => true,  'bind' => '0.0.0.0', 'port' => 514],
        'tls'  => [
            'enabled'   => false,
            'bind'      => '0.0.0.0',
            'port'      => 6514,
            'cert_file' => LW_ROOT . '/config/syslog-tls.pem', // cert + key, PEM
            'ca_file'   => null,   // set to require client certificates
        ],

        // Only accept datagrams from these hosts/networks. Empty = accept all.
        // Strongly recommended for UDP, which is trivially spoofable.
        'allow_from' => [],        // e.g. ['10.0.0.0/8', '192.168.1.1']

        // Events are buffered in memory and written in one batch. Flush happens
        // when either bound is reached, whichever comes first.
        'batch_size'     => 500,
        'flush_interval' => 1.0,   // seconds

        // If the database is unreachable, batches are written to var/spool as
        // newline-delimited JSON and replayed by `bin/logwarden-spool-replay`.
        // Without this, a database restart loses in-flight UDP events.
        'spool_on_db_error' => true,
        'max_message_bytes' => 65535,
    ],

    'winrm' => [
        // Defaults for every WinRM source; each source may override them.
        // HTTPS on 5986, because NTLM over plain HTTP hands the domain
        // account's challenge-response to anyone on the path.
        'tls'             => true,
        'port'            => 5986,

        // `winrm quickconfig` generates a self-signed certificate. Trusting it
        // blindly means any host on the path can impersonate the domain
        // controller, so verification stays on and the CA goes here — or you
        // issue the host a certificate from your own CA, which is better.
        'tls_verify'      => true,
        'ca_file'         => null,

        'connect_timeout' => 10,

        // Must exceed the SOAP OperationTimeout: a Receive legitimately blocks
        // on the host until output appears.
        'read_timeout'    => 90,
    ],

    'notify' => [
        // Outbound proxy for the Teams webhook, if the SOC network has one.
        // Example: 'http://proxy.corp.local:3128'
        'proxy' => null,

        // The webhook URL is admin-supplied and this process can reach the
        // whole internal network, so URLs resolving to private addresses are
        // rejected. Enable only if you deliver through an internal relay.
        'allow_private_targets' => false,
    ],

    'web' => [
        // 'ldap'  - Active Directory, with local accounts as the way back in
        //           when the domain controller is the thing that broke
        // 'local' - local accounts only
        'auth_mode'        => 'ldap',

        // Absolute lifetime: a session ends after this however active it is,
        // so a stolen one cannot be kept alive by using it.
        'session_ttl'      => 8 * 3600,
        // Idle lifetime, renewed on each request.
        'session_idle_ttl' => 60 * 60,

        // Permission level for an authenticated account that matches no
        // mapping. Empty means such a login is refused, which is the safe
        // default: a new AD account should not silently gain access.
        'default_role'     => '',
        // Sent as Strict-Transport-Security once you terminate TLS.
        'behind_tls'       => true,

        // Used to build the "open in LogWarden" link in Teams cards. Leave
        // empty and the cards simply carry no link.
        'base_url'         => 'https://logwarden.example.local',
    ],

    // Requires php8.4-ldap. Without the extension the directory login is
    // unavailable and only local accounts work.
    'ldap' => [
        // Tried in order; the first that answers is used.
        'hosts'       => ['ldaps://dc01.example.local', 'ldaps://dc02.example.local'],
        'base_dn'     => 'DC=example,DC=local',

        // How the login name becomes something the directory binds as.
        // Active Directory accepts the user principal name, so '%s@example.local'
        // is usually right. An OpenLDAP directory wants a full DN, e.g.
        // 'uid=%s,ou=Users,dc=example,dc=local'.
        'bind_format' => '%s@example.local',

        // Attribute holding the login name. sAMAccountName for AD, uid for
        // most others.
        'login_attribute' => 'sAMAccountName',

        'start_tls'   => false,   // set when connecting over ldap:// on port 389
        'tls_verify'  => true,
        'tls_ca_file' => null,
        'timeout'     => 5,

        // Resolve group membership transitively via AD's matching rule, so a
        // user who is in SOC-Admins through a nested group is recognised.
        // Costs one extra search per login.
        'nested_groups' => false,

        // Optional service account, used only by the reachability check on the
        // user administration page. Stored encrypted in `secrets`.
        'service_bind_dn'    => null,
        'service_secret_ref' => null,
    ],

    'log' => [
        'path'  => LW_ROOT . '/var/log/logwarden.log',
        'level' => 'info',     // debug | info | warning | error
        'stderr' => true,      // also write to stderr (systemd journal)
    ],

    'retention' => [
        // Partitions are created this many days ahead by bin/logwarden-maintenance.
        'partitions_ahead' => 7,
    ],
];
